  <dosage>
    <extension url="http://hemonc.org/fhir/StructureDefinition/day-of-cycle">
      <valueInteger value="1"/>
    </extension>
    <text value="Carboplatin AUC 5 IV over 30–60 minutes on day 1 of a 21-day cycle"/>
    <patientInstruction value="Dose target is exposure (AUC), not milligrams. Computed mg = 5 × (effective GFR + 25) at $apply time. GFR formula and cap are institution policy."/>
    <timing>
      <repeat>
        <boundsRange>
          <low>
            <value value="3"/>
            <unit value="1"/>
            <system value="http://unitsofmeasure.org"/>
          </low>
          <high>
            <value value="6"/>
            <unit value="1"/>
            <system value="http://unitsofmeasure.org"/>
          </high>
        </boundsRange>
        <duration value="30"/>
        <durationMax value="60"/>
        <durationUnit value="min"/>
        <frequency value="1"/>
        <period value="21"/>
        <periodUnit value="d"/>
      </repeat>
    </timing>
    <route>
      <coding>
        <system value="http://snomed.info/sct"/>
        <code value="47625008"/>
        <display value="Intravenous route"/>
      </coding>
    </route>
    <doseAndRate>
      <type>
        <coding>
          <system value="http://hemonc.org/fhir/CodeSystem/sig-target-type"/>
          <code value="target-AUC"/>
        </coding>
      </type>
      <doseQuantity>
        <value value="5"/>
        <unit value="AUC"/>
        <system value="http://hemonc.org/fhir/CodeSystem/hemonc"/>
        <code value="134425"/>
      </doseQuantity>
    </doseAndRate>
  </dosage>
  <dynamicValue>
    <path value="dosageInstruction[0].doseAndRate[0].doseQuantity.value"/>
