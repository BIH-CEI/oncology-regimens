/// url = 'http://hemonc.org/fhir/StructureMap/Medication4to6'
/// name = 'ESRCMedication4to6'
/// title = 'European SACT Regimen Catalog: catalog Medication, R4 to R6'
/// status = 'draft'
/// description = 'Converts the catalog (kind-of-drug) Medication of this IG from R4 to R6 (6.0.0-snapshot1, Medication as canonical resource per FHIR-57813). The artifact-* extensions become native canonical elements; medication-classification stays an extension until FHIR-59521 is applied; status is translated to PublicationStatus (FHIR-59543) and the original R4 code is kept in a cross-version extension on the primitive. NOT EXECUTED YET - see README.'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Medication" alias MedicationR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Medication" alias MedicationR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

// R4 Medication status (active | inactive | entered-in-error) -> R6 PublicationStatus.
// FHIR-59543: inactive and entered-in-error become retired; active is unchanged.
conceptmap "MedicationStatus4to6" {
  prefix s = "http://hl7.org/fhir/CodeSystem/medication-status"
  prefix t = "http://hl7.org/fhir/publication-status"

  s:active             - t:active
  s:inactive           - t:retired
  s:"entered-in-error" - t:retired
}

group Medication(source src : MedicationR4, target tgt : MedicationR6) <<type+>> {
  // Resource / DomainResource parts, copied explicitly so that the artifact-*
  // extensions are NOT duplicated as extensions on the R6 side.
  src.id -> tgt.id;
  src.meta -> tgt.meta;
  src.implicitRules -> tgt.implicitRules;
  src.language -> tgt.language;
  src.text -> tgt.text;
  src.contained -> tgt.contained;
  src.modifierExtension -> tgt.modifierExtension;

  // Canonical metadata: pre-adopted in R4 as artifact-* extensions -> native in R6.
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-url') -> tgt.url = (e.value) "artifactUrl";
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-version') -> tgt.version = (e.value) "artifactVersion";
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-name') -> tgt.name = (e.value) "artifactName";
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-title') -> tgt.title = (e.value) "artifactTitle";
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-publisher') -> tgt.publisher = (e.value) "artifactPublisher";
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-description') -> tgt.description = (e.value) "artifactDescription";
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-date') -> tgt.date = (e.value) "artifactDate";
  src.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/artifact-jurisdiction') -> tgt.jurisdiction = (e.value) "artifactJurisdiction";

  // Every other extension is carried over unchanged. This includes
  // medication-classification (no native Medication.classification in
  // 6.0.0-snapshot1; FHIR-59521 pending) and medication-type.
  src.extension as e where (url.startsWith('http://hl7.org/fhir/StructureDefinition/artifact-').not()) -> tgt.extension as t then Extension(e, t) "otherExtensions";

  src.identifier -> tgt.identifier;
  src.code -> tgt.code;

  // status: translate, and keep the original R4 code on the primitive so that
  // 6to4 can restore inactive vs entered-in-error (both become retired).
  src.status as v -> tgt.status = translate(v, '#MedicationStatus4to6', 'code') as ts,
    ts.extension as x,
    x.url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-Medication.status',
    x.value = v "statusWithOriginal";

  src.manufacturer -> tgt.marketingAuthorizationHolder; // renamed in R5
  src.form -> tgt.doseForm;                              // renamed in R5
  src.ingredient as s -> tgt.ingredient as t then MedicationIngredient(s, t);
  src.batch as s -> tgt.instance as t then MedicationBatch(s, t);   // renamed in R6
  // src.amount (R4 Ratio) has no R6 element; not used by this IG.
}

group MedicationIngredient(source src, target tgt) extends BackboneElement {
  src.item -> tgt.item;
  src.isActive -> tgt.isActive;
  src.strength -> tgt.strength;
}

group MedicationBatch(source src, target tgt) extends BackboneElement {
  src.lotNumber -> tgt.lotNumber;
  src.expirationDate -> tgt.expirationDate;
}
