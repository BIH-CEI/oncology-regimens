// European SACT Regimen Catalog: ConceptMap, R6 -> R4. Inverse of
// ConceptMap_4to6. relationship -> equivalence, restoring the R4 code that
// 4to6 kept on the primitive; R6-only elements (property, additionalAttribute,
// allowedRelationship, element.valueSet/noMap/comment, target.valueSet/property,
// unmapped.relationship/valueSet/comment) are kept in cross-version extensions
// or, for noMap, expressed as an unmatched target.

map "http://hemonc.org/fhir/StructureMap/ConceptMap6to4" = "ESRCConceptMap6to4"

conceptmap "Relationship6to4" {
  prefix s = "http://hl7.org/fhir/concept-map-relationship"
  prefix t = "http://hl7.org/fhir/concept-map-equivalence"

  s:"related-to"                     - t:relatedto
  s:equivalent                       - t:equivalent
  s:"source-is-narrower-than-target" - t:wider
  s:"source-is-broader-than-target"  - t:narrower
  s:"not-related-to"                 - t:unmatched
}

uses "http://hl7.org/fhir/6.0/StructureDefinition/ConceptMap" alias ConceptMapR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/ConceptMap" alias ConceptMapR4 as target

group ConceptMap(source src : ConceptMapR6, target tgt : ConceptMapR4) <<type+>> {
  src.id as v -> tgt.id = v "id";
  src.meta as v -> tgt.meta = v "meta";
  src.implicitRules as v -> tgt.implicitRules = v "implicitRules";
  src.language as v -> tgt.language = v "language";
  src.text as v -> tgt.text = v "text";
  src.contained as v -> tgt.contained = v "contained";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.url as v -> tgt.url = v "url";
  src.identifier first as v -> tgt.identifier = v "identifier";
  src.identifier not_first as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.identifier', x.value = v "identifierOverflow";
  src.version as v -> tgt.version = v "version";
  src.versionAlgorithm as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.versionAlgorithm[x]', x.value = v "versionAlgorithm";
  src.name as v -> tgt.name = v "name";
  src.title as v -> tgt.title = v "title";
  src.status as v -> tgt.status = v "status";
  src.experimental as v -> tgt.experimental = v "experimental";
  src.date as v -> tgt.date = v "date";
  src.publisher as v -> tgt.publisher = v "publisher";
  src.contact as v -> tgt.contact = v "contact";
  src.description as v -> tgt.description = v "description";
  src.useContext as v -> tgt.useContext = v "useContext";
  src.jurisdiction as v -> tgt.jurisdiction = v "jurisdiction";
  src.purpose as v -> tgt.purpose = v "purpose";
  src.copyright as v -> tgt.copyright = v "copyright";
  src.copyrightLabel as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/StructureDefinition/artifact-copyrightLabel', x.value = v "copyrightLabel";
  src.approvalDate as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.approvalDate', x.value = v "approvalDate";
  src.lastReviewDate as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.lastReviewDate', x.value = v "lastReviewDate";
  src.effectivePeriod as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.effectivePeriod', x.value = v "effectivePeriod";
  src.topic as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.topic', x.value = v "topic";
  src.author as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.author', x.value = v "author";
  src.editor as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.editor', x.value = v "editor";
  src.reviewer as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.reviewer', x.value = v "reviewer";
  src.endorser as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.endorser', x.value = v "endorser";
  src.relatedArtifact as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.relatedArtifact', x.value = v "relatedArtifact";
  src.property as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.property', x.value = v "property";
  src.additionalAttribute as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.additionalAttribute', x.value = v "additionalAttribute";
  src.allowedRelationship as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.allowedRelationship', x.value = v "allowedRelationship";
  src.sourceScope : uri as v -> tgt.source = v "sourceUri";
  src.sourceScope : canonical as v -> tgt.source = v "sourceCanonical";
  src.targetScope : uri as v -> tgt.target = v "targetUri";
  src.targetScope : canonical as v -> tgt.target = v "targetCanonical";
  src.group as s -> tgt.group as t then ConceptMapGroup(s, t) "group";
}

group ConceptMapGroup(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e where (url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-ConceptMap.group.sourceVersion') -> tgt.sourceVersion = (e.value) "sourceVersion";
  src.extension as e where (url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-ConceptMap.group.targetVersion') -> tgt.targetVersion = (e.value) "targetVersion";
  src.extension as e where (url.startsWith('http://hl7.org/fhir/4.0/StructureDefinition/extension-').not()) -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.source as v -> tgt.source = v "source";
  src.target as v -> tgt.target = v "target";
  src.element as s -> tgt.element as t then ConceptMapGroupElement(s, t) "element";
  src.unmapped as s -> tgt.unmapped as t then ConceptMapGroupUnmapped(s, t) "unmapped";
}

group ConceptMapGroupElement(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.code as v -> tgt.code = v "code";
  src.display as v -> tgt.display = v "display";
  src.valueSet as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.element.valueSet', x.value = v "valueSet";
  src.comment as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.element.comment', x.value = v "comment";
  src.noMap as v where ($this = true) -> tgt.target as t, t.equivalence = 'unmatched' "noMap";
  src.target as s -> tgt.target as t then ConceptMapGroupElementTarget(s, t) "target";
}

group ConceptMapGroupElementTarget(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.code as v -> tgt.code = v "code";
  src.display as v -> tgt.display = v "display";
  src.valueSet as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.element.target.valueSet', x.value = v "valueSet";
  src.relationship as v where (extension('http://hl7.org/fhir/4.0/StructureDefinition/extension-ConceptMap.group.element.target.equivalence').exists())
    -> tgt.equivalence = (v.extension('http://hl7.org/fhir/4.0/StructureDefinition/extension-ConceptMap.group.element.target.equivalence').value) "equivalenceRestored";
  src.relationship as v where (extension('http://hl7.org/fhir/4.0/StructureDefinition/extension-ConceptMap.group.element.target.equivalence').exists().not())
    -> tgt.equivalence = translate(v, '#Relationship6to4', 'code') "equivalenceTranslated";
  src.comment as v -> tgt.comment = v "comment";
  src.property as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.element.target.property', x.value = v "property";
  src.dependsOn as s -> tgt.dependsOn as t then ConceptMapOtherElement(s, t) "dependsOn";
  src.product as s -> tgt.product as t then ConceptMapOtherElement(s, t) "product";
}

group ConceptMapOtherElement(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e where (url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-ConceptMap.group.element.target.dependsOn.system') -> tgt.system = (e.value) "system";
  src.extension as e where (url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-ConceptMap.group.element.target.dependsOn.display') -> tgt.display = (e.value) "display";
  src.extension as e where (url.startsWith('http://hl7.org/fhir/4.0/StructureDefinition/extension-').not()) -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.attribute as v -> tgt.property = v "property";
  src.value : string as v -> tgt.value = v "valueString";
  src.value : code as v -> tgt.value = v "valueCode";
  src.valueSet as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.element.target.dependsOn.valueSet', x.value = v "valueSet";
}

group ConceptMapGroupUnmapped(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.mode as v -> tgt.mode = v "mode";
  src.code as v -> tgt.code = v "code";
  src.display as v -> tgt.display = v "display";
  src.valueSet as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.unmapped.valueSet', x.value = v "valueSet";
  src.relationship as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.unmapped.relationship', x.value = v "relationship";
  src.comment as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ConceptMap.group.unmapped.comment', x.value = v "comment";
  src.otherMap as v -> tgt.url = v "url";
}

group Extension(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.url as v -> tgt.url = v "url";
  src.value as v -> tgt.value = v "value";
  src.extension as e -> tgt.extension as t then Extension(e, t) "nested";
}
