// European SACT Regimen Catalog: PlanDefinition (regimen, variant, derived
// protocol, formulary), R4 -> R6. Self-contained replacement for the
// generated xver map. Changes handled: action.code 0..* -> 0..1 (first code
// native, further codes in a cross-version extension), relatedAction.actionId
// -> targetId, action.input/output DataRequirement -> backbone with
// requirement, action.timing[x] without dateTime/Period, string -> markdown
// copies. dynamicValue paths that address MedicationRequest.dosageInstruction
// are rewritten as in ActivityDefinition_4to6.
//
// Executed by scripts/xver/xver.py with the HL7 validator (see README.md).

map "http://hemonc.org/fhir/StructureMap/PlanDefinition4to6" = "ESRCPlanDefinition4to6"

uses "http://hl7.org/fhir/4.0/StructureDefinition/PlanDefinition" alias PlanDefinitionR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/PlanDefinition" alias PlanDefinitionR6 as target

group PlanDefinition(source src : PlanDefinitionR4, target tgt : PlanDefinitionR6) <<type+>> {
  src.id as v -> tgt.id = v "id";
  src.meta as v -> tgt.meta = v "meta";
  src.implicitRules as v -> tgt.implicitRules = v "implicitRules";
  src.language as v -> tgt.language = v "language";
  src.text as v -> tgt.text = v "text";
  src.contained as v -> tgt.contained = v "contained";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";

  src.url as v -> tgt.url = v "url";
  src.identifier as v -> tgt.identifier = v "identifier";
  src.version as v -> tgt.version = v "version";
  src.name as v -> tgt.name = v "name";
  src.title as v -> tgt.title = v "title";
  src.subtitle as v -> tgt.subtitle = v "subtitle";
  src.type as v -> tgt.type = v "type";
  src.status as v -> tgt.status = v "status";
  src.experimental as v -> tgt.experimental = v "experimental";
  src.subject : CodeableConcept as v -> tgt.subject = v "subjectCodeableConcept";
  src.subject : Reference as v -> tgt.subject = v "subjectReference";
  src.date as v -> tgt.date = v "date";
  src.publisher as v -> tgt.publisher = v "publisher";
  src.contact as v -> tgt.contact = v "contact";
  src.description as v -> tgt.description = v "description";
  src.useContext as v -> tgt.useContext = v "useContext";
  src.jurisdiction as v -> tgt.jurisdiction = v "jurisdiction";
  src.purpose as v -> tgt.purpose = v "purpose";
  src.usage as v -> tgt.usage = v "usage";
  src.copyright as v -> tgt.copyright = v "copyright";
  src.approvalDate as v -> tgt.approvalDate = v "approvalDate";
  src.lastReviewDate as v -> tgt.lastReviewDate = v "lastReviewDate";
  src.effectivePeriod as v -> tgt.effectivePeriod = v "effectivePeriod";
  src.topic as v -> tgt.topic = v "topic";
  src.author as v -> tgt.author = v "author";
  src.editor as v -> tgt.editor = v "editor";
  src.reviewer as v -> tgt.reviewer = v "reviewer";
  src.endorser as v -> tgt.endorser = v "endorser";
  src.relatedArtifact as v -> tgt.relatedArtifact = v "relatedArtifact";
  src.library as v -> tgt.library = v "library";
  src.goal as s -> tgt.goal as t then PlanDefinitionGoal(s, t) "goal";
  src.action as s -> tgt.action as t then PlanDefinitionAction(s, t) "action";
}

group PlanDefinitionGoal(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.category as v -> tgt.category = v "category";
  src.description as v -> tgt.description = v "description";
  src.priority as v -> tgt.priority = v "priority";
  src.start as v -> tgt.start = v "start";
  src.addresses as v -> tgt.addresses = v "addresses";
  src.documentation as v -> tgt.documentation = v "documentation";
  src.target as s -> tgt.target as t then PlanDefinitionGoalTarget(s, t) "target";
}

group PlanDefinitionGoalTarget(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.measure as v -> tgt.measure = v "measure";
  src.detail as v -> tgt.detail = v "detail";
  src.due as v -> tgt.due = v "due";
}

group PlanDefinitionAction(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.prefix as v -> tgt.prefix = v "prefix";
  src.title as v -> tgt.title = v "title";
  src.description as v -> tgt.description = v "description";
  src.textEquivalent as v -> tgt.textEquivalent = v "textEquivalent";
  src.priority as v -> tgt.priority = v "priority";
  // code 0..* -> 0..1: the first code is native, the rest are kept in a cross-version extension.
  src.code first as v -> tgt.code = v "code";
  src.code not_first as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-PlanDefinition.action.code', x.value = v "codeOverflow";
  src.reason as v -> tgt.reason = v "reason";
  src.documentation as v -> tgt.documentation = v "documentation";
  src.goalId as v -> tgt.goalId = v "goalId";
  src.subject : CodeableConcept as v -> tgt.subject = v "subjectCodeableConcept";
  src.subject : Reference as v -> tgt.subject = v "subjectReference";
  src.trigger as v -> tgt.trigger = v "trigger";
  src.condition as s -> tgt.condition as t then PlanDefinitionActionCondition(s, t) "condition";
  src.input as v -> tgt.input as i, i.requirement = v "input";
  src.output as v -> tgt.output as o, o.requirement = v "output";
  src.relatedAction as s -> tgt.relatedAction as t then PlanDefinitionActionRelatedAction(s, t) "relatedAction";
  src.timing : Timing as v -> tgt.timing = v "timingTiming";
  src.timing : Age as v -> tgt.timing = v "timingAge";
  src.timing : Duration as v -> tgt.timing = v "timingDuration";
  src.timing : Range as v -> tgt.timing = v "timingRange";
  src.timing : dateTime as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-PlanDefinition.action.timing[x]', x.value = v "timingDateTime";
  src.timing : Period as v -> tgt.extension as x, x.url = 'http://hl7.org/fhir/4.0/StructureDefinition/extension-PlanDefinition.action.timing[x]', x.value = v "timingPeriod";
  src.participant as s -> tgt.participant as t then PlanDefinitionActionParticipant(s, t) "participant";
  src.type as v -> tgt.type = v "type";
  src.groupingBehavior as v -> tgt.groupingBehavior = v "groupingBehavior";
  src.selectionBehavior as v -> tgt.selectionBehavior = v "selectionBehavior";
  src.requiredBehavior as v -> tgt.requiredBehavior = v "requiredBehavior";
  src.precheckBehavior as v -> tgt.precheckBehavior = v "precheckBehavior";
  src.cardinalityBehavior as v -> tgt.cardinalityBehavior = v "cardinalityBehavior";
  src.definition : canonical as v -> tgt.definition = v "definitionCanonical";
  src.definition : uri as v -> tgt.definition = v "definitionUri";
  src.transform as v -> tgt.transform = v "transform";
  src.dynamicValue as s -> tgt.dynamicValue as t then PlanDefinitionActionDynamicValue(s, t) "dynamicValue";
  src.action as s -> tgt.action as t then PlanDefinitionAction(s, t) "action";
}

group PlanDefinitionActionCondition(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.kind as v -> tgt.kind = v "kind";
  src.expression as v -> tgt.expression = v "expression";
}

group PlanDefinitionActionRelatedAction(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.actionId as v -> tgt.targetId = v "targetId";   // renamed in R5
  src.relationship as v -> tgt.relationship = v "relationship";
  src.offset as v -> tgt.offset = v "offset";
}

group PlanDefinitionActionParticipant(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.type as v -> tgt.type = v "type";
  src.role as v -> tgt.role = v "role";
}

group PlanDefinitionActionDynamicValue(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.extension as e -> tgt.extension as t then Extension(e, t) "extension";
  src.modifierExtension as e -> tgt.modifierExtension as t then Extension(e, t) "modifierExtension";
  src.path as v -> tgt.path = (v.replaceMatches('dosageInstruction\\[(\\d+)\\]', 'dosageInstruction.step[$1].component[0]')) "path";
  src.expression as v -> tgt.expression = v "expression";
}

group Extension(source src, target tgt) {
  src.id as v -> tgt.id = v "id";
  src.url as v -> tgt.url = v "url";
  src.value as v -> tgt.value = v "value";
  src.extension as e -> tgt.extension as t then Extension(e, t) "nested";
}
