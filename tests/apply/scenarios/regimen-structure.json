{
  "title": "Regimen structure: one cycle group, two concurrent day-1 components",
  "description": "The RequestGroup keeps the cycle action with its timing (q21d, 3 to 6 cycles) and both drug actions on day 1, paclitaxel concurrent with carboplatin; both MedicationRequests are emitted and the CarePlan instantiates the versioned PlanDefinition.",
  "planDefinition": "regimen-2554-variant-144842",
  "subject": "Patient/demo-cp-1",
  "fixtures": [
    "fixtures/patient-demo-cp-1.json"
  ],
  "expect": {
    "status": 200,
    "assertions": [
      {
        "fhirpath": "instantiatesCanonical",
        "equals": "http://hemonc.org/fhir/PlanDefinition/regimen-2554-variant-144842|2026-03-12"
      },
      {
        "fhirpath": "contained.ofType(MedicationRequest).count()",
        "equals": 2
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).count()",
        "equals": 1
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.where(id = 'cycle').timing.repeat.period",
        "equals": 21
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.where(id = 'cycle').timing.repeat.count",
        "equals": 3
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.where(id = 'cycle').timing.repeat.countMax",
        "equals": 6
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.where(id = 'cycle').selectionBehavior",
        "equals": "all"
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.where(id = 'cycle').action.count()",
        "equals": 2
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.action.where(id = 'paclitaxel-d1').relatedAction.where(actionId = 'carboplatin-d1').relationship",
        "equals": "concurrent-with-start"
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.action.extension('http://hemonc.org/fhir/StructureDefinition/day-of-cycle').value.where($this = 1).count()",
        "equals": 2
      },
      {
        "fhirpath": "contained.ofType(RequestGroup).action.action.resource.reference",
        "count": 2
      },
      {
        "fhirpath": "activity.reference.reference",
        "equals": "#regimen-2554-variant-144842"
      }
    ]
  }
}
