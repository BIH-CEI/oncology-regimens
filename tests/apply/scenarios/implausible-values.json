      {
        "fhirpath": "contained.ofType(MedicationRequest).where(medication.reference = 'Medication/hemonc-drug-88-carboplatin').dosageInstruction[0].doseAndRate[0].doseQuantity.value",
        "exists": false
      },
      {
        "fhirpath": "contained.ofType(MedicationRequest).where(medication.reference = 'Medication/hemonc-drug-379-paclitaxel').dosageInstruction[0].doseAndRate[0].doseQuantity.value",
        "exists": false
      },
      {
        "fhirpath": "contained.ofType(OperationOutcome).issue.diagnostics",
        "exists": true
      }
    ]
  },
  "expectedFailure": {
    "issue": "oncology-regimens-m75",
    "reason": "doses are Phase 0 constants, inputs are not checked"
  }
