  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ConceptMap srl-to-hemonc-variant</b></p><a name=\"srl-to-hemonc-variant\"> </a><a name=\"hcsrl-to-hemonc-variant\"> </a><p>Mapping from https://srl.org.nz/regimens to <a href=\"CodeSystem-hemonc.html\">http://hemonc.org/fhir/CodeSystem/hemonc</a></p><br/><p>Mapping from <code>https://srl.org.nz/regimens</code> to <a href=\"CodeSystem-hemonc.html\">HemOnc Ontology (fragment, Phase 0 spike)</a></p><table class=\"grid\"><tr><td><b>Source Code</b></td><td><b>Relationship</b></td><td><b>Target Code</b></td><td><b>Comment</b></td></tr><tr><td>52101000210105 (CRC Metastatic – mFOLFOX6 [bolus and infusion] [high dose folinic acid] v2.0.2)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>133145 (mFOLFOX6 Variant #06)</td><td>Oxaliplatin 85/2h, folinic acid 400/2h, 5-FU 400 bolus + 2400/46h, q14d. Infusion durations match.</td></tr><tr><td>588251000210108 (CRC Metastatic – mFOLFOX6 [high dose folinic acid] (no bolus) v1.0.0)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-relatedto\" title=\"relatedto\">is related to</a></td><td>133145 (mFOLFOX6 Variant #06)</td><td>omit-action: fluorouracil 400 mg/m² bolus. No HemOnc variant drops the bolus at otherwise identical doses.</td></tr><tr><td>52201000210102 (CRC Adjuvant – mFOLFOX6 [low dose folinic acid] v2.0.0)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-relatedto\" title=\"relatedto\">is related to</a></td><td>133145 (mFOLFOX6 Variant #06)</td><td>replace-dose: folinic acid 400 mg/m² IV 2 h → 50 mg flat IV 2 min. Lowest HemOnc leucovorin dose for mFOLFOX6 is 200 mg/m².</td></tr></table></div>"
  ] ;
  fhir:ConceptMap.url [ fhir:value "http://hemonc.org/fhir/ConceptMap/srl-to-hemonc-variant"] ;
