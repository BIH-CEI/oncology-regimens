     fhir:ImplementationGuide.definition.resource [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Medication" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hemonc.org/fhir/Medication/med-example-carboplatin> ;
         fhir:Reference.reference [ fhir:value "Medication/med-example-carboplatin" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Carboplatin" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Kind-of-drug Medication for carboplatin with the full coding stack (HemOnc CUI, RxNorm, UNII, EMA SPOR SMS, ATC-WHO, ATC-DE, ASK) and HemOnc classification. Canonical metadata via artifact-* extensions (R6: native Medication.url/version/name/publisher)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hemonc.org/fhir/PlanDefinition/regimen-2554-variant-144842> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/regimen-2554-variant-144842" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Carboplatin and Paclitaxel (CP) — Variant #83 (Carbo AUC 5 + Paclitaxel 175 mg/m² q21d)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "One executable variant of the Carboplatin + Paclitaxel regimen (HemOnc cui 2554). Single 21-day cycle pattern repeated 3–6 times: Carboplatin target AUC 5 + Paclitaxel 175 mg/m², both IV on day 1. Sourced from HemOncKB sigs.csv snapshot 2026-03-12 (variant_cui 144842, first reported in the MITO-2 trial). This Phase 0 artifact does not include premedications, dose-modification rules, or hold-for-counts logic — those are deferred to subsequent Library resources." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActivityDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hemonc.org/fhir/ActivityDefinition/sig-carboplatin-auc5-d1-q21d> ;
         fhir:Reference.reference [ fhir:value "ActivityDefinition/sig-carboplatin-auc5-d1-q21d" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Carboplatin AUC 5 IV over 30–60 min, day 1, q21d" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "One sig from HemOnc Regimen 2554 ('Carboplatin and Paclitaxel (CP)') Variant #83 (cui 144842). Carboplatin as primary systemic component, target AUC 5 IV over 30–60 minutes, day 1 of a 21-day cycle, for 3–6 cycles. The declared dose is a target AUC; the dynamicValue invokes the Calvert helper to compute the mg at $apply time using the patient's GFR." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 3 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
